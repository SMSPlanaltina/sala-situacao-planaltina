<!DOCTYPE html>
<html lang="pt-BR" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sala de Situação em Saúde — Planaltina/GO</title>

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0284c7',
              600: '#0369a1',
              700: '#075985',
              900: '#0c4a6e',
            }
          }
        }
      }
    }
  </script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Leaflet CSS & JS (Mapas Vetoriais / GeoJSON do QGIS) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
      font-family: 'JetBrains Mono', monospace;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .dark ::-webkit-scrollbar-thumb {
      background: #334155;
    }
    #map-container {
      height: 540px;
      width: 100%;
      border-radius: 0.75rem;
      z-index: 10;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-sky-500 selection:text-white transition-colors duration-200">

  <div class="flex h-screen overflow-hidden">

    <!-- SIDEBAR (NÍVEL 1 DE NAVEGAÇÃO) -->
    <aside id="sidebar" class="w-64 flex-shrink-0 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col justify-between transition-all duration-200 z-30">
      <div>
        <!-- Logo / Cabeçalho Institucional -->
        <div class="h-16 px-5 flex items-center gap-3 border-b border-slate-200 dark:border-slate-800">
          <div class="w-9 h-9 rounded-lg bg-sky-600 flex items-center justify-center text-white shadow-sm">
            <i data-lucide="activity" class="w-5 h-5"></i>
          </div>
          <div class="leading-tight">
            <h1 class="font-bold text-sm tracking-tight text-slate-900 dark:text-white">Sala de Situação</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">SMS • Planaltina/GO</p>
          </div>
        </div>

        <!-- Menu Principal -->
        <div class="p-3 space-y-1">
          <p class="px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Módulos Analíticos</p>

          <button onclick="switchMainTab('visao-geral')" id="nav-visao-geral" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
            <div class="flex items-center gap-3">
              <i data-lucide="layout-dashboard" class="w-4 h-4 flex-shrink-0"></i>
              <span>Visão Executiva</span>
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">Geral</span>
          </button>

          <button onclick="switchMainTab('pqavs')" id="nav-pqavs" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors bg-sky-50 text-sky-700 dark:bg-sky-950/60 dark:text-sky-400">
            <div class="flex items-center gap-3">
              <i data-lucide="shield-check" class="w-4 h-4 flex-shrink-0"></i>
              <span>Vigilância (PQA-VS)</span>
            </div>
            <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-900/60 text-sky-700 dark:text-sky-300">14</span>
          </button>

          <button onclick="switchMainTab('aps')" id="nav-aps" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
            <div class="flex items-center gap-3">
              <i data-lucide="heart-pulse" class="w-4 h-4 flex-shrink-0"></i>
              <span>Atenção Primária (APS)</span>
            </div>
            <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300">25 eSF</span>
          </button>

          <button onclick="switchMainTab('proprios')" id="nav-proprios" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
            <div class="flex items-center gap-3">
              <i data-lucide="flame" class="w-4 h-4 flex-shrink-0"></i>
              <span>Indicadores Próprios</span>
            </div>
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          </button>

          <button onclick="switchMainTab('mapas')" id="nav-mapas" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
            <div class="flex items-center gap-3">
              <i data-lucide="map-pin" class="w-4 h-4 flex-shrink-0"></i>
              <span>Inteligência Geográfica</span>
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400">QGIS</span>
          </button>
        </div>
      </div>

      <!-- Rodapé da Sidebar: Status da Planilha Google Sheets -->
      <div class="p-3 border-t border-slate-200 dark:border-slate-800 space-y-2">
        <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Fonte de Dados</span>
            <span id="sync-badge" class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Online
            </span>
          </div>
          <p id="data-source-label" class="text-xs text-slate-600 dark:text-slate-300 truncate">Google Sheets / SISAB</p>
          <button onclick="openSheetsModal()" class="mt-2 w-full py-1.5 px-2.5 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-700 text-xs font-medium text-slate-700 dark:text-slate-200 rounded border border-slate-200 dark:border-slate-700 flex items-center justify-center gap-1.5 transition">
            <i data-lucide="sheet" class="w-3.5 h-3.5 text-emerald-600"></i>
            Conectar Google Sheets
          </button>
        </div>
      </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <div class="flex-1 flex flex-col overflow-hidden">

      <!-- TOPBAR FIXA (FILTROS GLOBAIS & AÇÕES) -->
      <header class="h-16 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800 px-6 flex items-center justify-between z-20">
        <div class="flex items-center gap-3">
          <h2 id="page-title" class="text-base font-semibold text-slate-900 dark:text-white">
            Vigilância em Saúde (PQA-VS)
          </h2>
          <span class="hidden sm:inline-block text-slate-300 dark:text-slate-700">|</span>
          <span id="page-subtitle" class="hidden sm:inline-block text-xs text-slate-500 dark:text-slate-400">
            Portaria GM/MS Nº 6.878/2025 • 14 Indicadores Pactuados
          </span>
        </div>

        <!-- Controles e Filtros Globais -->
        <div class="flex items-center gap-2.5">
          <!-- Filtro Ano -->
          <div class="flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg px-2.5 py-1.5 border border-slate-200 dark:border-slate-700">
            <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-500 mr-1.5"></i>
            <label for="filter-year" class="text-xs text-slate-500 dark:text-slate-400 mr-1.5">Ano:</label>
            <select id="filter-year" onchange="renderPqavs(currentIndicatorKey)" class="bg-transparent text-xs font-semibold text-slate-800 dark:text-slate-200 focus:outline-none cursor-pointer">
              <option value="2026" selected>2026</option>
              <option value="2025">2025</option>
              <option value="2024">2024</option>
            </select>
          </div>

          <!-- Modo de Exibição dos Gráficos PQA-VS -->
          <div id="top-chart-mode-wrapper" class="hidden md:flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg px-2.5 py-1.5 border border-slate-200 dark:border-slate-700">
            <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-slate-500 mr-1.5"></i>
            <select id="filter-chart-mode" onchange="renderPqavs(currentIndicatorKey)" class="bg-transparent text-xs font-semibold text-slate-800 dark:text-slate-200 focus:outline-none cursor-pointer">
              <option value="adaptive" selected>Gráficos: Até Último Mês Registrado</option>
              <option value="full">Gráficos: Ano Inteiro (Jan - Dez)</option>
            </select>
          </div>

          <!-- Botão Ficha Técnica -->
          <button onclick="toggleDrawer(true)" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-sky-50 hover:bg-sky-100 text-sky-700 dark:bg-sky-950/70 dark:hover:bg-sky-900 dark:text-sky-300 border border-sky-200/60 dark:border-sky-800/60 flex items-center gap-1.5 transition" title="Ver Ficha de Qualificação do Indicador">
            <i data-lucide="info" class="w-3.5 h-3.5"></i>
            <span class="hidden sm:inline">Ficha Técnica</span>
          </button>

          <!-- Botão Dark Mode -->
          <button onclick="toggleDarkMode()" class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition" title="Alternar Modo Escuro (Gabinete de Crise)">
            <i id="theme-icon" data-lucide="moon" class="w-4 h-4"></i>
          </button>
        </div>
      </header>

      <!-- CONTEÚDO ROLÁVEL -->
      <main class="flex-1 overflow-y-auto p-6 space-y-6">

        <!-- ==========================================
             ABA 1: VIGILÂNCIA EM SAÚDE (PQA-VS - 14 INDICADORES)
             ========================================== -->
        <section id="tab-pqavs" class="space-y-6">
          <div class="bg-white dark:bg-slate-900 p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2 px-1">
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Selecione o Indicador PQA-VS (Portaria GM/MS Nº 6.878/2025):</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                <span id="top-meta-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-medium border border-emerald-200 dark:border-emerald-800/60">
                  <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                  Meta Atingida
                </span>
              </div>
            </div>
            <div id="pqavs-subtabs-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-1.5"></div>
          </div>

          <!-- BENTO GRID: 4 KPI CARDS PQA-VS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span id="card1-title" class="text-xs font-medium text-slate-500 dark:text-slate-400">Meta Anual Pactuada</span>
                <span class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  <i data-lucide="target" class="w-4 h-4"></i>
                </span>
              </div>
              <div class="my-3">
                <div id="kpi-meta-anual" class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white tabular-nums">952</div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                <span id="card1-footer-left">Pactuação 2026</span>
                <span class="font-semibold text-slate-700 dark:text-slate-300">Ministério da Saúde</span>
              </div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span id="card2-title" class="text-xs font-medium text-slate-500 dark:text-slate-400">Meta Mensal Estimada</span>
                <span class="p-1.5 rounded-lg bg-sky-50 dark:bg-sky-950 text-sky-600 dark:text-sky-400">
                  <i data-lucide="calendar-range" class="w-4 h-4"></i>
                </span>
              </div>
              <div class="my-3">
                <div id="kpi-meta-mensal" class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white tabular-nums">79,33</div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                <span id="card2-footer-left">Média linear (12 meses)</span>
                <span id="card2-footer-right" class="font-mono text-sky-600 dark:text-sky-400">Meta/mês</span>
              </div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span id="card3-title" class="text-xs font-medium text-slate-500 dark:text-slate-400">Registros Acumulados</span>
                <span class="p-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400">
                  <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                </span>
              </div>
              <div class="my-2.5 flex items-baseline gap-2">
                <div id="kpi-acumulado" class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white tabular-nums">742</div>
                <span id="kpi-perc-anual" class="text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400">(77,9% do ano)</span>
              </div>
              <div class="space-y-2">
                <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
                  <div id="kpi-progress-bar" class="bg-indigo-600 h-full rounded-full transition-all duration-300" style="width: 77.9%"></div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                  <span id="kpi-esperado-label">Esperado até Junho:</span>
                  <strong id="kpi-esperado-valor" class="font-mono text-slate-700 dark:text-slate-300">475,98</strong>
                </div>
              </div>
            </div>

            <div id="kpi-saldo-card" class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-emerald-200/90 dark:border-emerald-900/60 shadow-sm flex flex-col justify-between relative overflow-hidden">
              <div class="flex items-center justify-between">
                <span id="card4-title" class="text-xs font-medium text-slate-500 dark:text-slate-400">Saldo de Registros (vs. Meta)</span>
                <span id="kpi-saldo-icon" class="p-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400">
                  <i data-lucide="trending-up" class="w-4 h-4"></i>
                </span>
              </div>
              <div class="my-3 flex items-baseline gap-2">
                <div id="kpi-saldo" class="text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400 tabular-nums">+266,02</div>
                <span id="kpi-saldo-tag" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">Superávit</span>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                <span id="kpi-performance-periodo">155,9% da meta até Jun</span>
                <span id="kpi-status-meta" class="text-emerald-600 dark:text-emerald-400 font-semibold">Dentro da meta</span>
              </div>
            </div>
          </div>

          <!-- BENTO GRID: GRÁFICOS PRINCIPAIS PQA-VS -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 id="chart1-title" class="text-sm font-semibold text-slate-900 dark:text-white">Registros Acumulados vs. Meta Acumulada por Mês</h3>
                  <p id="chart1-subtitle" class="text-xs text-slate-500 dark:text-slate-400">Evolução progressiva de Janeiro a Junho de 2026</p>
                </div>
                <span id="chart1-badge" class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">Jan - Jun</span>
              </div>
              <div class="h-72">
                <canvas id="chartAcumulado"></canvas>
              </div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 id="chart2-title" class="text-sm font-semibold text-slate-900 dark:text-white">Registros Mensais vs. Meta Mensal por Mês</h3>
                  <p id="chart2-subtitle" class="text-xs text-slate-500 dark:text-slate-400">Comparativo mensal direto contra a linha de corte (79,33)</p>
                </div>
                <span id="chart2-badge" class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">Jan - Jun</span>
              </div>
              <div class="h-72">
                <canvas id="chartMensal"></canvas>
              </div>
            </div>
          </div>

          <!-- TABELA PQA-VS -->
          <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
              <div>
                <h3 id="table-title" class="text-sm font-semibold text-slate-900 dark:text-white">Detalhamento Mensal Auditável (2026)</h3>
                <p id="table-subtitle" class="text-xs text-slate-500 dark:text-slate-400">Alinhamento numérico tabular estrito para inspeção rápida</p>
              </div>
              <button onclick="exportCurrentCSV()" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center gap-1.5 transition">
                <i data-lucide="download" class="w-3.5 h-3.5"></i>
                Exportar Planilha Modelo (14 Indicadores)
              </button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-slate-200 dark:border-slate-800 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 bg-slate-50/60 dark:bg-slate-800/40">
                    <th class="py-3 px-4">Mês</th>
                    <th id="th-col-mensal" class="py-3 px-4 text-right">Registros Mensais</th>
                    <th id="th-col-meta-mes" class="py-3 px-4 text-right">Meta Mensal</th>
                    <th id="th-col-acum" class="py-3 px-4 text-right">Acumulado Real</th>
                    <th id="th-col-meta-acum" class="py-3 px-4 text-right">Meta Acumulada</th>
                    <th id="th-col-saldo" class="py-3 px-4 text-right">Saldo Acumulado</th>
                    <th class="py-3 px-4 text-center">Status Mensal</th>
                  </tr>
                </thead>
                <tbody id="pqavs-table-body" class="divide-y divide-slate-200/60 dark:divide-slate-800 text-xs"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ==========================================
             ABA 2: VISÃO EXECUTIVA (RESUMO DOS 14 INDICADORES + APS)
             ========================================== -->
        <section id="tab-visao-geral" class="hidden space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">PQA-VS (Vigilância)</span>
                <span id="exec-pqavs-badge" class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">12 / 14 metas</span>
